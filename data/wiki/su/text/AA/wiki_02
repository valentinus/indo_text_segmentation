<li>&lt;a href="t%C3%A9trosa"&gt;tétrosa&lt;/a&gt;: &lt;a href="%C3%A9ritrosa"&gt;éritrosa&lt;/a&gt;</li>
<li>&lt;a href="p%C3%A9ntosa"&gt;péntosa&lt;/a&gt;: &lt;a href="lixosa"&gt;lixosa&lt;/a&gt;, &lt;a href="ribosa"&gt;ribosa&lt;/a&gt;, jeung &lt;a href="d%C3%A9oxiribosa"&gt;déoxiribosa&lt;/a&gt;</li>
<li>&lt;a href="h%C3%A9xosa"&gt;héxosa&lt;/a&gt;: &lt;a href="idosa"&gt;idosa&lt;/a&gt;, &lt;a href="glukosa"&gt;glukosa&lt;/a&gt;, &lt;a href="fruktosa"&gt;fruktosa&lt;/a&gt;, jeung &lt;a href="galaktosa"&gt;galaktosa&lt;/a&gt;</li>

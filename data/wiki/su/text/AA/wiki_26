<li>&lt;a href="Angola"&gt;Angola&lt;/a&gt;</li>
<li>&lt;a href="Guinea%20Bissau"&gt;Guinea Bissau&lt;/a&gt; / (&lt;a href="Guin%C3%A9-Bissau"&gt;Guiné-Bissau&lt;/a&gt;)</li>
<li>&lt;a href="Mozambik"&gt;Mozambik&lt;/a&gt; / (&lt;a href="Mo%C3%A7ambique"&gt;Moçambique&lt;/a&gt;)</li>
<li>&lt;a href="Sao%20Tome%20dan%20Principe"&gt;Sao Tome dan Principe&lt;/a&gt; / (&lt;a href="S%C3%A3o%20Tom%C3%A9%20e%20Pr%C3%ADncipe"&gt;São Tomé e Príncipe&lt;/a&gt;)</li>

<ul>
<li>Sumber direktori virtual beragam</li>
</ul>
<ul>
<li>Integrasi akun Windows</li>
</ul>
<ul>
<li>Kontrol Akses</li>
</ul>
<ul>
<li>Otentikasi pilihan</li>
</ul>
<ul>
<li>Pilihan FTPS</li>
</ul>

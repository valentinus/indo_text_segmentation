<li>kasus nominatif</<li>
<li>kasus vokatif</<li>
<li>kasus akusatif</<li>
<li>kasus instrumentalis</<li>
<li>kasus datif</<li>
<li>kasus ablatif</<li>
<li>kasus genetif</<li>
<li>kasus lokatif</<li>
</ol>

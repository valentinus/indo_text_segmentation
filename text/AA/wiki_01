<li>Provinsi Chimbu (Simbu)</<li>
<li>Provinsi Dataran Tinggi Timur</<li>
<li>Provinsi Britania Baru Timur</<li>
<li>Provinsi Sepik Timur</<li>
<li>Provinsi Enga</<li>
<li>Provinsi Teluk</<li>
<li>Provinsi Madang</<li>
<li>Provinsi Manus</<li>
<li>Provinsi Teluk Milne</<li>
<li>Provinsi Morobe</<li>
<li>Provinsi Irlandia Baru</<li>
<li>Provinsi Oro (Utara)</<li>
<li>Daerah Otonom Bougainville</<li>

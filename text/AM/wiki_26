</dl>
<ul>
<li>Hyunmoo-1</li>
<li>Hyunmoo-2A</li>
<li>Hyunmoo-2B</li>
<li>Hyunmoo-2c</li>
<li>Hyunmoo-3A</li>
<li>Hyunmoo-3B</li>

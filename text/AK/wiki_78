 QR(0, 4, 8, 12) // kolom 1
 QR(1, 5, 9, 13) // kolom 2
 QR(2, 6, 10, 14) // kolom 3
 QR(3, 7, 11, 15) // kolom 4
 // Ronde genap
 QR(0, 5, 10, 15) // diagonal 1 (diagonal utama)
 QR(1, 6, 11, 12) // diagonal 2
 QR(2, 7, 8, 13) // diagonal 3
 QR(3, 4, 9, 14) // diagonal 4

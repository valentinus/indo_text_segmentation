sub sedol_check_digit
 my ($sedol) = @_;
 die &amp;quot;invalid SEDOL format: `$sedol'\n&amp;quot;
 if $sedol !~ /^[0-9A-Z]{6,7}$/;
 my @chars = split //, $sedol;
 my $sum = 0;
 for my $i ( 0 .. $#weights )
 my $char = $chars[$i];
 my $value = (strtol $char, 36)[0];;
 $sum += $value * $weights[$i];
 
 return (10 - ($sum % 10)) % 10;

<li>Hukum komutatif</<li>
<ul>
<li>p ∧ q ≡ q ∧ p</li>
<li>p ∨ q ≡ q ∨ p</li>
</ul>
<li>Hukum asosiatif</<li>
<ul>
<li>(p ∧ q) ∧ r ≡ p ∧ (q ∧ r)</li>
<li>(p ∨ q) ∨ r ≡ p ∨ (q ∨ r)</li>
</ul>
<li>Hukum distributif</<li>
<ul>
<li>p ∧ (q ∨ r) ≡ (p ∧ q) ∨ (p ∧ r)</li>
<li>p ∨ (q ∧ r) ≡ (p ∨ q) ∧ (p ∨ r)</li>
</ul>
<li>Hukum identitas</<li>
<ul>
<li>p ∧ B ≡ p</li>
<li>p ∨ S ≡ p</li>

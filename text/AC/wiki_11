<li>6-31g</li>
<li>6-31g*</li>
<li>6-31+g*</li>
<li>6-31g(3df, 3pd)</li>
<li>6-311g</li>
<li>6-311g*</li>
<li>6-311+g*</li>
<li>SV(P)</li>

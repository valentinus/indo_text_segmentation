<li>Keninjal</li>
</ul>
</ul>
<li>Melayik Lainnya (bukan pengelompokan genetis)</li>
<ul>
<li>Melayu Baku</li>
<li>Melayu Jakarta</li>
<li>Melayu Ketapang</li>
<li>Melayu Banjar</li>
<li>Melayu Kutai</li>
<li>Melayu Brunei</li>

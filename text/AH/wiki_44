<li>Universitas Negeri Makassar (UNM), Makassar</<li>
<li>Universitas Islam Negeri Alauddin, Makassar</<li>
<li>Akademi Pertanian, Bogor</<li>
<li>Universitas Siliwangi (Unsil), Tasikmalaya</<li>
<li>Akademi Bahasa Arab, Makassar</<li>
<li>dan lain-lain.</<li>
</ol>

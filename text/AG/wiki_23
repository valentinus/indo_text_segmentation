<li>Bahasa Inggris Amerika Serikat</li>
<li>Bahasa Amerika Umum</li>
<li>Bahasa Inggris Kanada</li>
<li>Bahasa Inggris Amerika Utara</li>
<li>Bahasa Inggris Internasional</li>
<li>Received Pronunciation</li>
</ul>

<li>Bendahara</li>
</ul>
<li>Bagian Pembantu Umum</<li>
<li>Bagian Ibadah</<li>
<li>Bagian Bahasa</<li>
<li>Bagian Kesenian</<li>
<li>Bagian Olahraga</<li>
<li>Bagian Penerimaan Tamu</<li>
<li>Bagian Kebersihan dan Pertamanan</<li>
<li>Bagian Kesehatan</<li>
<li>Bagian Dapur</<li>
<li>Pengurus Asrama</<li>
<ul>
<li>Pengurus Asrama Harapan</li>
